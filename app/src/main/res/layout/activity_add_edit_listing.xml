<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_body">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface_white"
        android:elevation="4dp"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/tvScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Add Listing"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Accommodation Name"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_input_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:hint="e.g. Varsity Heights Residence"
                android:textColorHint="@color/text_placeholder"
                android:textColor="@color/text_primary"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Location"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <EditText
                android:id="@+id/etLocation"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_input_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:hint="e.g. Braamfontein, Johannesburg"
                android:textColorHint="@color/text_placeholder"
                android:textColor="@color/text_primary"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Campus(es) Served"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <EditText
                android:id="@+id/etCampus"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_input_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:hint="e.g. Wits University"
                android:textColorHint="@color/text_placeholder"
                android:textColor="@color/text_primary"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Description"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <EditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_input_field"
                android:padding="16dp"
                android:hint="Tell students about the property..."
                android:textColorHint="@color/text_placeholder"
                android:textColor="@color/text_primary"
                android:minLines="3"
                android:gravity="top" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Additional Features"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <CheckBox
                android:id="@+id/cbTransport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Transport Included"
                android:layout_marginBottom="8dp" />

            <CheckBox
                android:id="@+id/cbFurnished"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fully Furnished"
                android:layout_marginBottom="8dp" />

            <CheckBox
                android:id="@+id/cbPrepaidElectricity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Prepaid Electricity"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Amenities"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupAmenities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:singleSelection="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Assign Landlord"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <Spinner
                android:id="@+id/spinnerLandlord"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_input_field"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="20dp"
                android:background="@color/border_light" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Room Types &amp; Pricing"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <LinearLayout
                android:id="@+id/roomConfigContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/spinnerRoomType"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_input_field"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />

                <Spinner
                    android:id="@+id/spinnerRoomFunding"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etRoomPrice"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_input_field"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint="e.g. R2 500/mo"
                    android:textColorHint="@color/text_placeholder"
                    android:textSize="13sp"
                    android:singleLine="true" />

                <EditText
                    android:id="@+id/etRoomSpaces"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint="Spaces available"
                    android:textColorHint="@color/text_placeholder"
                    android:textSize="13sp"
                    android:inputType="number"
                    android:singleLine="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnAddRoomImage"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginBottom="10dp"
                android:gravity="center"
                android:text="Set Room Photo"
                android:textSize="12sp"
                android:textColor="@color/brand_blue"
                android:background="@drawable/bg_input_field"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tvRoomImageSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="No room photo selected"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnAddRoom"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:text="+ Add Room Type"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/brand_blue"
                android:background="@drawable/bg_toggle_container"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="20dp"
                android:background="@color/border_light" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Photos &amp; Videos"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnAddPhotos"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:gravity="center"
                    android:text="Add Photos"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_blue"
                    android:background="@drawable/bg_input_field"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnAddVideo"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Add Video"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_blue"
                    android:background="@drawable/bg_input_field"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvMediaSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:text="No photos or videos selected yet"
                android:textSize="12sp"
                android:textColor="@color/text_muted" />

            <TextView
                android:id="@+id/btnSaveListing"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center"
                android:text="Save Listing"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/surface_white"
                android:background="@drawable/bg_button_primary"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>