<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/reason_for_rejection"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etRejectionReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/e_g_fully_booked_maintenance_etc"
        android:inputType="textMultiLine"
        android:minLines="2"
        android:background="@drawable/bg_input_field"
        android:padding="12dp"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/suggest_an_alternative_time_optional"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etSuggestedTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/e_g_tomorrow_at_10_00"
        android:inputType="text"
        android:background="@drawable/bg_input_field"
        android:padding="12dp"
        android:textSize="14sp" />

</LinearLayout>