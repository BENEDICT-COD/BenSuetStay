# Android Studio / IntelliJ
*.iml
.idea/*
!.idea/gradle.xml
!.idea/misc.xml
.DS_Store

# Gradle / build output
.gradle/
.kotlin/
build/
/captures
.externalNativeBuild
.cxx
local.properties
gradle-app.setting

# Never commit compiled binaries
*.apk
*.aab
*.ap_
*.dex

# Logs / heap dumps
*.log
*.hprof

# Signing keys
*.jks
*.keystore

# google-services.json is committed on purpose (grading convenience). Firebase API keys
# for Android aren't secret; security comes from firestore.rules / storage.rules.
# Uncomment to stop committing it:
# app/google-services.json
